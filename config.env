KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm7325
KERNEL_SOURCE_BRANCH=lineage-23.2

# Base Motorola SM7325 QGKI configuration
KERNEL_CONFIG=vendor/lahaina-qgki_defconfig

# LineageOS/Dubai produces an uncompressed ARM64 Image
KERNEL_IMAGE_NAME=Image

ARCH=arm64

# Android 16-era LLVM
USE_LLVM=true
CLANG_VERSION=r563880
CLANG_BRANCH=android16-qpr2-release

EXTRA_CMDS=V=1

# KernelSU Next
KSU_VARIANT=kernelsu-next
KSU_REF=legacy
KSU_HOOK_MODE=kprobes

# KernelSU/root functionality
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
ENABLE_PATH_UMOUNT=true

# Keep these disabled for the first build
ENABLE_SUSFS=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# Build cache
ENABLE_CCACHE=true


