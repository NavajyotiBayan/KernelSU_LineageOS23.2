KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm7325
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/lahaina-qgki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

USE_LLVM=true
CLANG_VERSION=r547379
CLANG_BRANCH=main-kernel-2025

EXTRA_CMDS=V=1

KSU_VARIANT=kernelsu-next
KSU_REF=legacy
KSU_HOOK_MODE=auto

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
ENABLE_PATH_UMOUNT=true